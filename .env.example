AI_QUALITY_CONTEXT_PATH=ai-quality-platform

# Node 开发：本机 pnpm dev:* 服务端口
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=qtp_app
MYSQL_PASSWORD=qtp_dev_password
MYSQL_DATABASE=ai_quality_platform
QTP_AUTH_TOKEN_SECRET=replace-with-a-long-random-secret
QTP_ADMIN_USERNAME=admin
QTP_ADMIN_INITIAL_PASSWORD=replace-before-running-db-seed
WEB_PORT=3000
GATEWAY_PORT=8080
PLATFORM_SERVICE_PORT=3101
EXECUTION_SERVICE_PORT=3104
AI_INVOCATION_SERVICE_PORT=3105
PLATFORM_SERVICE_HOST=127.0.0.1
EXECUTION_SERVICE_HOST=127.0.0.1
AI_INVOCATION_SERVICE_HOST=127.0.0.1
WATCHPACK_POLLING=true
# @author codex 生产环境默认禁止被测应用地址访问 localhost、内网 IP 和 Docker 内部服务名。
# @author codex 如果被测系统部署在受控内网，请按 origin 显式放行，例如：http://192.168.11.107:8080,https://credit.example.com
QTP_ALLOWED_APP_INVOKE_ORIGINS=

# Docker 生产：只暴露 nginx 最终入口
MYSQL_ROOT_PASSWORD=replace-with-production-root-password
PUBLIC_WEB_PORT=5670
NEXT_PUBLIC_GATEWAY_ORIGIN=same-origin
