# QTP 单体 + SQLite 默认：零配置即可启动，以下全部为可选覆盖项。

# 数据库：留空则用包内 SQLite（packages/shared-database/prisma/dev.db）。
# 切 MySQL：把 schema.prisma 的 provider 改为 mysql，并设置下面这行。
# DATABASE_URL=mysql://user:password@127.0.0.1:3306/ai_quality_platform

# 初始管理员（仅 db:seed 时生效，不设则用默认 admin / admin123）
# QTP_ADMIN_USERNAME=admin
# QTP_ADMIN_INITIAL_PASSWORD=replace-before-running-db-seed

# 会话令牌密钥（生产建议设置长随机值）
# QTP_AUTH_TOKEN_SECRET=replace-with-a-long-random-secret
